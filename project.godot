config_version=5

[application]
config/name="Mundo Vivo"
config/version="4.0.0"
run/main_scene="res://scenes/vale.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Um diorama medieval explorável e inteiramente offline."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/use_nearest_mipmap_filter=true
environment/defaults/default_clear_color=Color(0.33, 0.48, 0.51, 1)
